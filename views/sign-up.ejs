<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <title>Sign Up</title>
</head>
<body>
  <% if (typeof errors !== "undefined" && errors.length > 0) { %>
    <ul>
      <% errors.forEach((err) => { %>
        <li><%= err %></li>
      <% }) %>
    </ul>
  <% } %>

  <h1>Sign Up</h1>
  <form action="/sign-up" method="POST">
    <label for="firstName">First Name</label>
    <input
      id="firstName"
      name="firstName"
      type="text"
      value="<%= (typeof formData !== 'undefined' && formData.firstName) ? formData.firstName : '' %>"
      required
    />

    <label for="lastName">Last Name</label>
    <input
      id="lastName"
      name="lastName"
      type="text"
      value="<%= (typeof formData !== 'undefined' && formData.lastName) ? formData.lastName : '' %>"
      required
    />

    <label for="username">Username</label>
    <input
      id="username"
      name="username"
      placeholder="username"
      type="text"
      value="<%= (typeof formData !== 'undefined' && formData.username) ? formData.username : '' %>"
      required
    />

    <label for="password">Password</label>
    <input id="password" name="password" type="password" required />

    <label for="confirmPassword">Confirm Password</label>
    <input id="confirmPassword" name="confirmPassword" type="password" required />

    <button type="submit">Sign Up</button>
  </form>
</body>
</html>