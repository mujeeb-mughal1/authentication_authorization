<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <title>New Message</title>
</head>
<body>
  <h1>Create a New Message</h1>
  <a href="/">Back to Home</a>

  <% if (errors && errors.length > 0) { %>
    <ul>
      <% errors.forEach((err) => { %>
        <li><%= err %></li>
      <% }) %>
    </ul>
  <% } %>

  <form action="/new-message" method="POST">
    <label for="title">Title</label>
    <input
      id="title"
      name="title"
      type="text"
      value="<%= (formData && formData.title) ? formData.title : '' %>"
      required
    />

    <label for="text">Message</label>
    <textarea id="text" name="text" rows="4" required><%= (formData && formData.text) ? formData.text : '' %></textarea>

    <button type="submit">Post Message</button>
  </form>
</body>
</html>