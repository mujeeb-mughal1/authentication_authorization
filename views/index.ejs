<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <title>Members Only</title>
</head>
<body>
  <nav>
    <a href="/">Home</a>
    <% if (currentUser) { %>
      <span>Signed in as <strong><%= currentUser.username %></strong></span>
      <a href="/new-message">Create a new message</a>
      <% if (!currentUser.is_member) { %>
        <a href="/join">Join the club</a>
      <% } %>
      <% if (!currentUser.is_admin) { %>
        <a href="/admin">Become Admin</a>
      <% } %>
      <form action="/log-out" method="POST" style="display:inline;">
        <button type="submit">Log Out</button>
      </form>
    <% } else { %>
      <a href="/log-in">Log In</a>
      <a href="/sign-up">Sign Up</a>
    <% } %>
  </nav>

  <h1>Members Only</h1>

  <% if (messages && messages.length > 0) { %>
    <ul>
      <% messages.forEach((message) => { %>
        <li>
          <h2><%= message.title %></h2>
          <p><%= message.text %></p>

          <% if (currentUser && (currentUser.is_member || currentUser.is_admin)) { %>
            <p>
              By <strong><%= message.first_name %> <%= message.last_name %></strong>
              (@<%= message.username %>)
            </p>
            <p><i><%= new Date(message.created_at).toLocaleString() %></i></p>
          <% } else { %>
            <p><em>Author: Anonymous (Join the club to view)</em></p>
          <% } %>

          <% if (currentUser && currentUser.is_admin) { %>
            <form action="/messages/<%= message.id %>/delete" method="POST">
              <button type="submit">Delete</button>
            </form>
          <% } %>
        </li>
      <% }) %>
    </ul>
  <% } else { %>
    <p>No messages yet.</p>
  <% } %>
</body>
</html>